# Database
DATABASE_URL=postgresql://user:password@localhost:5432/indianwalls

# Redis (Queue & Cache)
REDIS_URL=redis://localhost:6379

# OpenAI API
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx

# Object Storage (S3-compatible)
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=indianwalls-generated
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
CDN_BASE_URL=https://cdn.indianwalls.com

# NextAuth (if using)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# External APIs
RERA_API_KEY=your-rera-api-key
RERA_API_URL=https://maharera.mahaonline.gov.in/api
INFRA_API_KEY=your-infra-api-key
MARKET_API_KEY=your-market-api-key

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Queue Configuration
QUEUE_CONCURRENCY=2
QUEUE_MAX_RETRIES=3

# LLM Configuration
LLM_TEMPERATURE=0.25
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000

# Fetcher Cache TTL (hours)
CACHE_TTL_RERA=48
CACHE_TTL_INFRA=72
CACHE_TTL_MARKET=24
